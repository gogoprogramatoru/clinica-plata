# ----------------------------------------------------------------------------
# Clinica Plata — variabile de mediu (exemplu)
# Copiază acest fișier în `.env` și completează valorile reale.
# NU comite niciodată fișierul `.env` cu secrete reale.
# ----------------------------------------------------------------------------

# --- Bază de date (MySQL) ---
# Format: mysql://USER:PAROLA@HOST:PORT/NUME_BAZA
#  - DEV (local, docker-compose.yml): host `localhost`, port 3307
#  - PRODUCȚIE (compose.prod.yml): host `db` (numele serviciului), port 3306
DATABASE_URL="mysql://clinica:parola_puternica@localhost:3307/clinica_plata"

# --- MySQL: doar pentru containerul din compose.prod.yml ---
# Aceleași user/parolă/bază ca în DATABASE_URL de mai sus. Folosite de Docker
# Compose la crearea containerului MySQL în producție.
MYSQL_DATABASE="clinica_plata"
MYSQL_USER="clinica"
MYSQL_PASSWORD="parola_puternica"
MYSQL_ROOT_PASSWORD="alta_parola_puternica"

# --- NextAuth / Auth.js ---
# Secret folosit pentru semnarea JWT-urilor de sesiune și protecția CSRF.
# Generează cu: `openssl rand -base64 32`
AUTH_SECRET="schimba_ma_cu_un_secret_lung_si_aleator"
# URL-ul de bază al aplicației.
#  - DEV (local, http): lasă exact http://localhost:3000
#  - PRODUCȚIE (în spatele Caddy cu HTTPS): pune domeniul public, ex.
#    https://nurse-reception.sanmedica.ro
# ATENȚIE: dacă pui un URL "https://" în timp ce rulezi local pe http, NextAuth
# folosește cookie-uri "secure" pe care browserul le respinge peste http și NU
# te vei putea loga. Pentru local păstrează http://localhost:3000.
AUTH_URL="http://localhost:3000"
# Necesar când rulezi în spatele unui reverse proxy TLS.
AUTH_TRUST_HOST="true"

# --- Server / Socket.io ---
# Portul pe care ascultă serverul Node custom (Next + Socket.io pe același port).
PORT="3000"
# Hostname de bind. Local și în container: 0.0.0.0 (toate interfețele).
# Dacă rulezi direct pe host, în spatele unui proxy local: 127.0.0.1
HOSTNAME="0.0.0.0"
# Origini permise pentru CORS-ul Socket.io (separate prin virgulă).
# În producție pune domeniul public. Local se poate lăsa gol (same-origin).
SOCKET_ALLOWED_ORIGINS="https://nurse-reception.sanmedica.ro"

# --- Seed (cont admin inițial + conturi demo) ---
# Folosite DOAR de scriptul de seed pentru bootstrap-ul primului admin.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin!Schimba123"
SEED_RECEPTION_USERNAME="receptie"
SEED_RECEPTION_PASSWORD="Receptie!Schimba123"
SEED_NURSE_USERNAME="asistenta"
SEED_NURSE_PASSWORD="Asistenta!Schimba123"
