# ----------------------------------------------------------------------------
# Clinica Plata — variabile de mediu (exemplu)
#
# Pentru o instalare reală NU completa acest fișier de mână: rulează
#   scripts/gen-env.sh http://IP_SERVER:3000
# care generează un `.env` cu parole aleatoare (chmod 600) și îți afișează
# o singură dată credențialele conturilor create de seed.
#
# NU comite niciodată fișierul `.env` cu secrete reale.
# ----------------------------------------------------------------------------

# --- Bază de date (MySQL) ---
# Format: mysql://USER:PAROLA@HOST:PORT/NUME_BAZA
#  - DEV (local, compose.dev.yml): host `localhost`, port 3307
#  - ÎN CONTAINER (compose.yaml / compose.prod.yml): host `db`, port 3306
DATABASE_URL="mysql://clinica:parola_puternica@localhost:3307/clinica_plata"

# --- MySQL: doar pentru containerul de bază de date din compose ---
# Aceleași user/parolă/bază ca în DATABASE_URL de mai sus.
MYSQL_DATABASE="clinica_plata"
MYSQL_USER="clinica"
MYSQL_PASSWORD="parola_puternica"
MYSQL_ROOT_PASSWORD="alta_parola_puternica"

# --- NextAuth / Auth.js ---
# Secret folosit pentru semnarea JWT-urilor de sesiune și protecția CSRF.
# Generează cu: `openssl rand -base64 32`
AUTH_SECRET="schimba_ma_cu_un_secret_lung_si_aleator"

# Adresa exactă la care se deschide aplicația în browser, fără slash final.
#  - DEV:                 http://localhost:3000
#  - INSTALARE LOCALĂ:    http://192.168.1.50:3000   (IP-ul serverului din LAN)
#  - ÎN SPATELE UNUI TLS: https://subdomeniul-tau
#
# Protocolul de aici decide comportamentul de securitate al aplicației
# (src/lib/deployment.ts): pe `https://` sesiunea folosește cookie-uri
# `__Secure-`, se trimite HSTS și CSP-ul cere `upgrade-insecure-requests`; pe
# `http://` nu. Trebuie să corespundă realității — un `https://` declarat pe o
# instalare servită în http face login-ul imposibil.
AUTH_URL="http://localhost:3000"

# Necesar când rulezi în spatele unui reverse proxy.
AUTH_TRUST_HOST="true"

# --- Server / Socket.io ---
# Portul pe care ascultă serverul Node custom (Next + Socket.io pe același port).
PORT="3000"
# Hostname de bind. Local și în container: 0.0.0.0 (toate interfețele).
# Dacă rulezi direct pe host, în spatele unui proxy local: 127.0.0.1
HOSTNAME="0.0.0.0"
# Origini permise pentru CORS-ul Socket.io (separate prin virgulă).
# În producție: exact valoarea din AUTH_URL. Local se poate lăsa gol (same-origin).
SOCKET_ALLOWED_ORIGINS="http://localhost:3000"
# Portul publicat pe host de compose.yaml (instalarea locală). Schimbă-l dacă
# 3000 e deja ocupat pe server — atunci pune-l și în AUTH_URL.
APP_PORT="3000"

# --- Seed (conturile create la prima instalare) ---
# Parolele trebuie să aibă minim 10 caractere și să conțină litere și cifre
# (aceeași politică precum conturile create din interfața de admin).
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_RECEPTION_USERNAME="receptie"
SEED_RECEPTION_PASSWORD=""
SEED_NURSE_USERNAME="asistenta"
SEED_NURSE_PASSWORD=""
