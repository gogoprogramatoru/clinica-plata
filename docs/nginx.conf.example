# Exemplu de configurație nginx pentru Clinica Plata.
# Rol: reverse proxy HTTPS în fața serverului Node (Next + Socket.io) de pe 127.0.0.1:3000.
# Cheia pentru real-time: proxy corect al WebSocket-ului (Upgrade/Connection) pe /socket.io.

# Redirect HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name clinica.exemplu.ro;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name clinica.exemplu.ro;

    # --- TLS (ex. Let's Encrypt / certbot) ---
    ssl_certificate     /etc/letsencrypt/live/clinica.exemplu.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clinica.exemplu.ro/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Dimensiune upload rezonabilă (payload-uri mici JSON).
    client_max_body_size 1m;

    # --- WebSocket / Socket.io ---
    # Trebuie să fie ÎNAINTE de location / pentru a prinde handshake-ul WS.
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;   # conexiuni WS de lungă durată
        proxy_send_timeout 3600s;
    }

    # --- Aplicația Next.js ---
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
